# DON'T FORGET TO RENAME TO .env OR .env.local BEFORE PUSHING TO GIT
#
### DEVELOPMENT ONLY VARIABLES
# These variables need to be set for local development only
#
# Mandatory next-auth URL for localhost
NEXTAUTH_URL=http://app.localhost:3000
#
### PRODUCTION & DEVELOPMENT VARIABLES
# These variables need to be set for local development and when deployed on Vercel
#
# Supabase — Base de datos (Postgres) + Storage de imágenes
# URL del proyecto (ej. == https://xxxx.supabase.co ==)
NEXT_PUBLIC_SUPABASE_URL=https://gyccndblkxxkmciwobdr.supabase.co
# Clave anónima (segura para exponer en el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imd5Y2NuZGJsa3h4a21jaXdvYmRyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMzNzQ4NDMsImV4cCI6MjEwODk1MDg0M30.JlV4GrfB51B6OIIwS3s8Gs3p1mBoINYELkGTnL23Oo
# Service role key (SOLO servidor, para subir a Storage). Nunca la expongas.
